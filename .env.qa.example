# Public snapshot: live AI requires explicit operator opt-in and independent access/spend controls.
HOUSE_PLANNER_AI_ENABLED=0
# Copy to .env.qa.local only for manual authenticated QA. Never copy production
# credentials, OAuth refresh tokens, database exports, or service-account keys.
# The local launcher supplies source hashes and synthetic passwords automatically.
HOUSE_PLANNER_ENVIRONMENT=qa
GOOGLE_CLOUD_PROJECT=demo-house-planner-qa
HOUSE_PLANNER_BUCKET=demo-house-planner-qa.firebasestorage.app
HOUSE_PLANNER_ADMIN_EMAIL=
HOUSE_PLANNER_QA_EMAILS=qa.houseplanner.20260830@example.com,qa.houseplanner.outside@example.com
HOUSE_PLANNER_QA_PROJECT_IDS=qa-primary,qa-isolation
HOUSE_PLANNER_PUBLIC_URL=http://127.0.0.1:3000
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199
NEXT_PUBLIC_HOUSE_PLANNER_ENVIRONMENT=qa
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-house-planner-qa
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-house-planner-qa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-house-planner-qa.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
QA_BASE_URL=http://127.0.0.1:3000
QA_FIREBASE_PROJECT_ID=demo-house-planner-qa
QA_PROJECT_ID=qa-primary
QA_ISOLATION_PROJECT_ID=qa-isolation
QA_AI_MODE=disabled
QA_AI_ENABLED=0
QA_OWNER_PASSWORD=
QA_COMPANION_PASSWORD=
QA_EDITOR_PASSWORD=
QA_VIEWER_PASSWORD=
QA_RESTRICTED_PASSWORD=
QA_OUTSIDER_PASSWORD=
HOUSE_PLANNER_VAULT_RECOVERY_KEY=
# For a manually approved private cloud run, use the configured IAM proxy instead:
# QA_BASE_URL=http://127.0.0.1:8085
# QA_CLOUD_PROXY=1
# QA_TARGET_URL=https://house-planner-qa-PROJECT_NUMBER.us-central1.run.app
# QA_FIREBASE_PROJECT_ID=house-planner-qa-example
# QA_SERVICE_ACCOUNT=qa-runner@house-planner-qa-example.iam.gserviceaccount.com
# QA_AI_MODE=basic
# node scripts/qa-cloud-proxy.mjs (with QA-only WIF/ADC), then qa:regression
