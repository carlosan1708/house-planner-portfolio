# Public snapshot: live AI requires explicit operator opt-in and independent access/spend controls.
HOUSE_PLANNER_AI_ENABLED=0
# Safe local defaults. Start the Auth, Firestore and Storage emulators before
# authenticated API tests. Production deployment supplies its own explicit config.
HOUSE_PLANNER_ENVIRONMENT=qa
GOOGLE_CLOUD_PROJECT=demo-house-planner-qa
HOUSE_PLANNER_BUCKET=demo-house-planner-qa.firebasestorage.app
HOUSE_PLANNER_ADMIN_EMAIL=
HOUSE_PLANNER_QA_EMAILS=qa.houseplanner.20260830@example.com,qa.houseplanner.outside@example.com
HOUSE_PLANNER_QA_PROJECT_IDS=qa-primary,qa-isolation
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199

NEXT_PUBLIC_HOUSE_PLANNER_ENVIRONMENT=qa
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-house-planner-qa
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-house-planner-qa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-house-planner-qa.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Use the loopback origin locally. Cloud Run receives an explicit service URL
# from scripts/deploy-gcp.ps1.
HOUSE_PLANNER_PUBLIC_URL=http://127.0.0.1:3000

# Encrypted folder password reset. Use a dedicated 32-byte key (64 hex chars).
# Production uses house-planner-vault-recovery-key in Secret Manager.
HOUSE_PLANNER_VAULT_RECOVERY_KEY=

# Optional Google Sheets advanced editing. Use a separate web OAuth client.
# Register {HOUSE_PLANNER_PUBLIC_URL}/api/google-sheets/callback as its redirect URI.
# Enable the Google Drive API. Keep these values in Secret Manager in production.
HOUSE_PLANNER_GOOGLE_CLIENT_ID=
HOUSE_PLANNER_GOOGLE_CLIENT_SECRET=
# 32 random bytes encoded as 64 hexadecimal characters; encrypts refresh tokens.
HOUSE_PLANNER_GOOGLE_TOKEN_KEY=

# Private assistant configuration. Gemini authenticates with Google Application
# Default Credentials; no model API key is stored in this application.
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
QA_AI_ENABLED=0

# Local on-demand regression only. Put real values in .env.qa.local, never Git.
QA_BASE_URL=http://127.0.0.1:3000
QA_FIREBASE_PROJECT_ID=demo-house-planner-qa
QA_PROJECT_ID=qa-primary
QA_ISOLATION_PROJECT_ID=qa-isolation
QA_AI_MODE=disabled
QA_OWNER_EMAIL=qa.houseplanner.20260830@example.com
QA_OWNER_PASSWORD=
QA_COMPANION_EMAIL=qa.houseplanner.viewer.20260831@example.com
QA_COMPANION_PASSWORD=
QA_EDITOR_PASSWORD=
QA_VIEWER_PASSWORD=
QA_RESTRICTED_PASSWORD=
QA_OUTSIDER_PASSWORD=
HOUSE_PLANNER_GOOGLE_SERVICE_ACCOUNT=
